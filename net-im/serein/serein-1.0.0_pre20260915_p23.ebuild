inherit cargo desktop xdg

MY_PV=${PV/_pre/-nightly.}
MY_PV=${MY_PV/_p/.}

DESCRIPTION="Unofficial native Discord client written in Rust"
HOMEPAGE="https://github.com/ViceVerse-cz/Serein"
SRC_URI="
	https://github.com/ViceVerse-cz/Serein/archive/refs/tags/v${MY_PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/Serein-${MY_PV}"

LICENSE="|| ( Apache-2.0 MIT )"
# Rust dependencies, embedded fonts, and the Twemoji graphics atlas.
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC-BY-4.0 CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 OFL-1.1
	Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="test"
RESTRICT="!test? ( test )"

DEPEND="
	dev-libs/glib:2
	>=gui-libs/gtk-4.10:4
	media-libs/alsa-lib
	media-libs/gst-plugins-base:1.0
	media-libs/gstreamer:1.0
	net-libs/libsoup:3.0
	>=net-libs/webkit-gtk-2.40:6
"
RDEPEND="
	${DEPEND}
	!net-im/serein-bin
	dev-libs/wayland
	media-libs/fontconfig
	media-libs/gst-plugins-bad:1.0
	media-libs/gst-plugins-good:1.0
	media-libs/libglvnd
	media-libs/vulkan-loader
	media-plugins/gst-plugins-libav:1.0
	sys-apps/dbus
	sys-apps/xdg-desktop-portal
	virtual/secret-service
	x11-libs/libX11
	x11-libs/libXcursor
	x11-libs/libXi
	x11-libs/libXrandr
	x11-libs/libxcb
	x11-libs/libxkbcommon[X]
	x11-misc/xdg-utils
"
BDEPEND="
	dev-build/cmake
	dev-lang/nasm
	virtual/pkgconfig
"

QA_FLAGS_IGNORED="usr/bin/serein"

src_prepare() {
	default

	# Upstream applies the release version in CI after creating the source tag.
	sed -i -e "s/^version = \"0.1.0\"$/version = \"${MY_PV}\"/" Cargo.toml || die
	# Refresh local versions and GIT_CRATES paths while retaining registry pins.
	# A full cargo update tries to refetch egui even with the local patch table.
	cargo_env "${CARGO}" metadata --offline --format-version=1 > /dev/null || die
}

src_configure() {
	cargo_src_configure --frozen
}

src_test() {
	# The IPC test requires every temporary-directory ancestor to be owned by
	# root or the test user and not group-writable; Portage's build tree is not.
	local -a CARGO_SKIP_TESTS=(
		game_activity::native::tests::private_socket_roundtrip_contention_and_owned_cleanup
	)
	# Upstream's workspace suite uses synthetic fixtures without a Discord login.
	cargo_src_test --workspace
}

src_install() {
	dobin "$(cargo_target_dir)/serein"
	newmenu packaging/linux/serein.desktop cz.viceverse.serein.desktop
	insinto /usr/share/icons
	doins -r packaging/linux/hicolor

	dodoc README.md LICENSE-MIT LICENSE-APACHE THIRD_PARTY_NOTICES.md
	dodoc -r assets/licenses
	docinto licenses
	dodoc assets/fonts/*-OFL.txt assets/fonts/NotoSansCJK-LICENSE.txt
	newdoc assets/twemoji/LICENSE-GRAPHICS Twemoji-CC-BY-4.0.txt
	newdoc assets/twemoji/LICENSE-UNICODE Unicode-LICENSE.txt
	newdoc assets/icons/LICENSE Phosphor-Icons-MIT.txt
	newdoc assets/icons/LICENSE-SIMPLE-ICONS Simple-Icons-CC0.txt
	# Retain the modified MPL component's corresponding source with its notices.
	docinto source
	dodoc -r vendor/hpke-rs
}

pkg_postinst() {
	xdg_pkg_postinst
	elog "Serein requires a running Secret Service provider in your desktop session."
	elog "Enable a portal backend for file dialogs, such as xdg-desktop-portal-gtk."
}
