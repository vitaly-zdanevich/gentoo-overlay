#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

description="Telegram RuTracker bot long-poller"
supervisor="supervise-daemon"
command="/usr/bin/telegram-rutracker-poller"
command_user="telegram-rutracker-bot:telegram-rutracker-bot"
directory="/var/lib/telegram-rutracker-bot"
output_log="/var/log/telegram-rutracker-poller.log"
error_log="/var/log/telegram-rutracker-poller.log"
rc_ulimit="-n 65536"
respawn_delay=5
respawn_max=0

depend() {
	need net
	use telegram-bot-api
}

start_pre() {
	if [ ! -r /etc/telegram-rutracker-bot.env ]; then
		eerror "Missing /etc/telegram-rutracker-bot.env"
		return 1
	fi
	set -a
	# shellcheck disable=SC1091
	. /etc/telegram-rutracker-bot.env
	set +a
	if [ -z "${TELEGRAM_BOT_TOKEN}" ]; then
		eerror "Set TELEGRAM_BOT_TOKEN in /etc/telegram-rutracker-bot.env"
		return 1
	fi
	checkpath -d -m 0750 -o telegram-rutracker-bot:telegram-rutracker-bot \
		/var/lib/telegram-rutracker-bot \
		/var/lib/telegram-rutracker-bot/tmp \
		/var/lib/telegram-rutracker-bot/image-cache \
		/var/lib/telegram-rutracker-bot/catalog
	checkpath -f -m 0640 -o telegram-rutracker-bot:telegram-rutracker-bot "${output_log}"
}
