# Environment configuration for net-im/telegram-rutracker-bot.
# Used by telegram-rutracker-vm-worker, telegram-rutracker-poller, and
# rutracker-catalog-updater.

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_API_BASE_URL="http://127.0.0.1:8081"

VM_WORKER_SECRET=""
VM_WORKER_BIND="0.0.0.0:8080"

ALLOWED_TELEGRAM_USER_IDS=""
RUTRACKER_BASE_URLS="https://rutracker.org/forum,https://rutracker.net/forum,https://rutracker.nl/forum"
RUTRACKER_USERNAME=""
RUTRACKER_PASSWORD=""
RUTRACKER_COOKIE=""

IMAGE_CACHE_PUBLIC_BASE_URL=""
IMAGE_CACHE_DIR="/var/lib/telegram-rutracker-bot/image-cache"

MAX_FILE_MB="2000"
LAMBDA_TIMEOUT_SECONDS="86400"
DOWNLOAD_MARGIN_SECONDS="60"
DOWNLOAD_COUNTDOWN_LABEL="Download time budget"
DOWNLOAD_STATUS_INTERVAL_SECONDS="3600"

TORRENT_PEER_LIMIT="240"
SEED_TORRENTS="true"
TORRENT_LISTEN_PORT="49152"
SEED_DISK_RESERVE_MB="10240"

RUTRACKER_CATALOG_ENABLED="true"
RUTRACKER_CATALOG_PATH="/var/lib/telegram-rutracker-bot/catalog/rutracker.sqlite"
RUTRACKER_CATALOG_XML_TOPIC_ID="5591249"
RUTRACKER_CATALOG_DOWNLOAD_TIMEOUT_SECONDS="43200"

TMP_DIR="/var/lib/telegram-rutracker-bot/tmp"
RUST_LOG="info"
